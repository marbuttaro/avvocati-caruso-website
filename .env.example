RESEND_API_KEY=
RESEND_FROM_EMAIL="Caruso Avvocati <sito@carusoavvocati.it>"
CONTACT_TO_EMAIL=info@carusoavvocati.it

# I riferimenti pubblici iubenda sono in index.html e src/privacy/consent.js.
# Le eventuali credenziali IUBENDA_USER/IUBENDA_PASS servono solo per il browser:
# non aggiungere il prefisso VITE_ e non caricarle su Vercel.

# Dashboard /admin: solo server, mai usare il prefisso VITE_.
ADMIN_USERNAME=admin
# Generare almeno 16 caratteri casuali.
ADMIN_PASSWORD=
# Generare almeno 32 caratteri casuali, diverso dalla password.
ADMIN_SESSION_SECRET=
# Produzione: token dello store privato collegato da Vercel.
BLOB_READ_WRITE_TOKEN=
